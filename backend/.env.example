# ─── Base de datos MySQL ───────────────────────────────────────────────────────
DB_NAME=spare_tracker
DB_USER=spare_user
DB_PASSWORD=TU_PASSWORD_AQUI
DB_HOST=localhost
DB_PORT=3306
# ─── Base de datos NCE / CGNAT ────────────────────────────────────────────────
NCE_DB_NAME=nce_cgnat
NCE_DB_USER=cgnat
NCE_DB_PASSWORD=TU_PASSWORD_AQUI
NCE_DB_HOST=localhost
NCE_DB_PORT=3306

# ─── Base de datos Backbone / Core ────────────────────────────────────────────
BACKBONE_DB_NAME=backbone_core
BACKBONE_DB_USER=backbone
BACKBONE_DB_PASSWORD=TU_PASSWORD_AQUI
BACKBONE_DB_HOST=localhost
BACKBONE_DB_PORT=3306

# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True
